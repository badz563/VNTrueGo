# Optional remote SQLite for persistent data on Vercel. Provision a new Turso database,
# run npm run db:setup:remote once against that empty database, then set these in Vercel.
# Without both values, production reads the bundled demo destinations and feedback is unavailable.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
EVIDENCE_ENCRYPTION_KEY=
# ADMIN_EMAIL / ADMIN_PASSWORD are read only by the one-time bootstrap script.
# Do not store ADMIN_PASSWORD in a committed file.

# Optional. Without these, the planner uses the labeled Demo Mode.
AI_API_KEY=
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Partner demo mutations are enabled only in local development.
# Public Windows demo sets TRUEGO_LOCAL_DEMO=1, DATABASE_PATH and a separate
# EVIDENCE_ENCRYPTION_KEY only inside managed processes (npm run demo:start).
